# Mail settings for hpc/run_reminder.sh.
#
# Copy this file to ~/.config/tischedule/env (outside the repository, so it is
# never pushed to GitHub), fill in the values from HPC support, then:
#     chmod 600 ~/.config/tischedule/env

# The institutional mail relay reachable from the HPC.
SMTP_HOST=REPLACE_WITH_RELAY_HOST
SMTP_PORT=25

# starttls if the relay offers it (ask HPC support); otherwise none.
SMTP_SECURITY=starttls

# The reminders are sent from, and replies go to, this address.
SMTP_FROM=v.a.melogallegos@amsterdamumc.nl
REPLY_TO=v.a.melogallegos@amsterdamumc.nl

# Leave these unset for a relay that trusts the HPC without a login. Do not
# put your personal Amsterdam UMC password here: if the relay needs a login,
# ask for a service account instead.
# SMTP_USER=
# SMTP_PASSWORD=
